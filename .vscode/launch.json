{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sky: window",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Sky: health check",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--check"],
      "console": "integratedTerminal"
    },
    {
      "name": "Sky: chat CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/chat_cli.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Sky: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "console": "integratedTerminal"
    }
  ]
}
